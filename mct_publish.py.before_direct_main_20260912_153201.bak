RELEASES = {11: "v0.1.0", 19: "v0.2.0", 23: "v0.3.0", 30: "v0.4.0", 33: "v1.0.0"}

SENSITIVE_EXACT = {
    ".env", ".env.local", ".env.production", ".env.development",
    "id_rsa", "id_ed25519", "credentials.json", "service-account.json",
}
SENSITIVE_SUFFIXES = {".pem", ".p12", ".pfx", ".key"}

# Private authoring and publishing artifacts must never enter the public clone,
# even if one is accidentally placed inside a selected snapshot.
PRIVATE_PUBLIC_BASENAMES = {
    ".fix.txt",
    "agents.md",
    "commits.md",
    "linkedin_progressive_posts.txt",
    "mct_gpt_project_master_prompt.md",
    "mct_publish.py",
    "mobility_control_tower.md",
    "mobility_control_tower.pdf",
    "readme_publisher.md",
}
PRIVATE_PUBLIC_PREFIXES = {
    ".0 to hero",
    ".git",
    ".mct-publisher",
    "mobility_control_tower_publish",
    "progress",
}


class PublisherError(RuntimeError):
    pass


def run(cmd: list[str], cwd: Path | None = None, check: bool = True) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(
            cmd,
            cwd=str(cwd) if cwd else None,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=check,
        )
    except FileNotFoundError as exc:
        raise PublisherError(f"Required command not found: {cmd[0]}") from exc
    except subprocess.CalledProcessError as exc:
        detail = (exc.stderr or exc.stdout or "").strip()
        raise PublisherError(f"Command failed: {' '.join(cmd)}\n{detail}") from exc


def git(args: list[str], repo: Path, check: bool = True) -> subprocess.CompletedProcess:
    return run(["git", *args], cwd=repo, check=check)


def save_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False), encoding="utf-8")
    tmp.replace(path)


def load_json(path: Path, default: dict) -> dict:
    if not path.exists():
        return default
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return default


def ask(prompt: str, default: str | None = None) -> str:
    suffix = f" [{default}]" if default else ""
    value = input(f"{prompt}{suffix}: ").strip()
    return value or (default or "")


def yes_no(prompt: str, default: bool = False) -> bool:
    hint = "Y/n" if default else "y/N"
    value = input(f"{prompt} [{hint}]: ").strip().lower()
    if not value:
        return default
    return value in {"y", "yes"}


def setup_config(force: bool = False) -> dict:
    if CONFIG_FILE.exists() and not force:
        return load_json(CONFIG_FILE, {})

    print("\n=== First-time setup ===")
    default_progress = SCRIPT_DIR / "progress"
    progress_dir = Path(ask("Path to progress folder", str(default_progress))).expanduser().resolve()

    if not progress_dir.exists():
        raise PublisherError(f"Progress folder does not exist: {progress_dir}")
    validate_progress(progress_dir)

    default_repo = SCRIPT_DIR / "Mobility_Control_Tower_Publish"
    repo_dir = Path(ask("Path to the separate GitHub working copy", str(default_repo))).expanduser().resolve()

    if not repo_dir.exists():
        remote = ask("GitHub repository clone URL (HTTPS or SSH)")
        if not remote:
            raise PublisherError("A GitHub remote URL is required when the working copy does not exist.")
        repo_dir.parent.mkdir(parents=True, exist_ok=True)
        print(f"Cloning {remote} ...")
        run(["git", "clone", remote, str(repo_dir)])
    elif not (repo_dir / ".git").exists():
        if any(repo_dir.iterdir()):
            raise PublisherError(
                "The publishing directory exists but is not a Git repository.\n"
                "Use a separate empty directory or clone the GitHub repository first."
            )
        remote = ask("GitHub repository clone URL (HTTPS or SSH)")
        if not remote:
            raise PublisherError("A GitHub remote URL is required.")
        run(["git", "clone", remote, str(repo_dir)])

    # Existing local Git repository: make sure origin exists.
    if (repo_dir / ".git").exists():
        origin = git(["remote", "get-url", "origin"], repo_dir, check=False)
        if origin.returncode != 0:
            remote = ask("No origin remote found. GitHub repository URL (HTTPS or SSH)")
            if not remote:
                raise PublisherError("An origin remote is required for publishing.")
            git(["remote", "add", "origin", remote], repo_dir)

    branch = ask("Branch to publish", detect_branch(repo_dir) or "main")

    # Empty clones sometimes have no local branch yet.
    current = git(["branch", "--show-current"], repo_dir, check=False).stdout.strip()
    if not current:
        git(["switch", "-c", branch], repo_dir)
    elif current != branch:
        # Do not silently switch away from a dirty branch.
        if working_tree_lines(repo_dir):
            raise PublisherError("Working tree is not clean; clean it before switching branches.")
        existing = git(["show-ref", "--verify", f"refs/heads/{branch}"], repo_dir, check=False)
        if existing.returncode == 0:
            git(["switch", branch], repo_dir)
        else:
            git(["switch", "-c", branch], repo_dir)

    cfg = {
        "progress_dir": str(progress_dir),
        "repo_dir": str(repo_dir),
        "branch": branch,
    }
    save_json(CONFIG_FILE, cfg)
    if not STATE_FILE.exists():
        save_json(STATE_FILE, {"published_snapshot": 0, "history": []})
    print(f"\nSaved configuration to {CONFIG_FILE}")
    return cfg


def detect_branch(repo: Path) -> str:
    cp = git(["branch", "--show-current"], repo, check=False)
    return cp.stdout.strip()


def validate_progress(progress: Path) -> None:
    missing = [f"{i:02d}" for i in range(1, TOTAL + 1) if not (progress / f"{i:02d}").is_dir()]
    if missing:
        raise PublisherError(f"Missing snapshot folders: {', '.join(missing)}")
    if not (progress / "COMMITS.md").is_file():
        raise PublisherError(f"Missing {progress / 'COMMITS.md'}")


def load_commits(progress: Path) -> list[tuple[str, str]]:
    text = (progress / "COMMITS.md").read_text(encoding="utf-8")
    rows: list[tuple[str, str]] = []
    pattern = re.compile(r"^\s*(\d+)\.\s+\*\*(.+?)\*\*\s*-\s*(.+?)\s*$")
    for line in text.splitlines():
        m = pattern.match(line)
        if m:
            rows.append((m.group(2).strip(), m.group(3).strip()))
    if len(rows) != TOTAL:
        print(f"WARNING: Could not parse all {TOTAL} titles from COMMITS.md; using built-in verified titles.")
        return FALLBACK_COMMITS.copy()
    return rows


def origin_url(repo: Path) -> str:
    cp = git(["remote", "get-url", "origin"], repo, check=False)
    return cp.stdout.strip() if cp.returncode == 0 else "(no origin)"


def working_tree_lines(repo: Path) -> list[str]:
    cp = git(["status", "--porcelain=v1", "--untracked-files=all"], repo)
    return [line for line in cp.stdout.splitlines() if line.strip()]


def progress_bar(n: int, width: int = 40) -> str:
    n = max(0, min(TOTAL, n))
    filled = round(width * n / TOTAL)
    return "[" + "#" * filled + "-" * (width - filled) + f"] {n:02d}/{TOTAL} ({n * 100 // TOTAL:3d}%)"


def has_remote_branch(repo: Path, branch: str) -> bool:
    cp = git(["ls-remote", "--exit-code", "--heads", "origin", branch], repo, check=False)
    return cp.returncode == 0


def fetch_remote(repo: Path, branch: str) -> None:
    if origin_url(repo) == "(no origin)":
        return
    if has_remote_branch(repo, branch):
        git(["fetch", "origin", branch], repo)


def log_subjects(repo: Path, ref: str = "HEAD", limit: int = 200) -> list[str]:
    cp = git(["log", ref, f"--max-count={limit}", "--format=%s"], repo, check=False)
    if cp.returncode != 0:
        return []
    return [x.strip() for x in cp.stdout.splitlines() if x.strip()]


def infer_snapshot_from_ref(repo: Path, ref: str, commits: list[tuple[str, str]]) -> int:
    subjects = log_subjects(repo, ref)
    if not subjects:
        return 0
    title_to_num = {title: i + 1 for i, (title, _) in enumerate(commits)}
    # Newest matching snapshot is the current one.
    for subject in subjects:
        normalized = re.sub(r" \(#\d+\)$", "", subject)
        if normalized in title_to_num:
            return title_to_num[normalized]
    return 0


def remote_snapshot(repo: Path, branch: str, commits: list[tuple[str, str]]) -> int:
    if origin_url(repo) == "(no origin)" or not has_remote_branch(repo, branch):
        return 0
    fetch_remote(repo, branch)
    return infer_snapshot_from_ref(repo, f"origin/{branch}", commits)


def local_snapshot(repo: Path, commits: list[tuple[str, str]]) -> int:
    return infer_snapshot_from_ref(repo, "HEAD", commits)


def repo_last_commit(repo: Path, ref: str = "HEAD") -> str:
    cp = git(["log", "-1", "--format=%h  %s  (%ad)", "--date=short", ref], repo, check=False)
    return cp.stdout.strip() if cp.returncode == 0 and cp.stdout.strip() else "(no commits yet)"


def relative_files(root: Path) -> dict[str, Path]:
    result: dict[str, Path] = {}
    for p in root.rglob("*"):
        if p.is_file():
            result[p.relative_to(root).as_posix()] = p
    return result


def private_public_reason(relative_path: str) -> str | None:
    """Return why a path is private, or ``None`` when it is public project material."""
    normalized = relative_path.replace("\\", "/")
    while normalized.startswith("./"):
        normalized = normalized[2:]
    folded = normalized.casefold()
    basename = folded.rsplit("/", 1)[-1]

    if basename in PRIVATE_PUBLIC_BASENAMES or basename.startswith("mct-publish."):
        return "private authoring/publishing filename"
    for prefix in PRIVATE_PUBLIC_PREFIXES:
        if folded == prefix or folded.startswith(prefix + "/"):
            return "private authoring/publishing path"
    return None


def private_public_paths(root: Path) -> list[str]:
    """List private artifacts found below a candidate public snapshot."""
    return sorted(rel for rel in relative_files(root) if private_public_reason(rel))


def public_relative_files(root: Path) -> dict[str, Path]:
    """Return only files that are eligible for synchronization to the public clone."""
    return {
        rel: path
        for rel, path in relative_files(root).items()
        if private_public_reason(rel) is None
    }


def sha256(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def compare_snapshots(a: Path | None, b: Path) -> tuple[list[str], list[str], list[str]]:
    af = public_relative_files(a) if a and a.exists() else {}
    bf = public_relative_files(b)
    added = sorted(set(bf) - set(af))
    deleted = sorted(set(af) - set(bf))
    common = set(af) & set(bf)
    modified = sorted(p for p in common if sha256(af[p]) != sha256(bf[p]))
    return added, modified, deleted


def print_file_group(label: str, items: list[str], max_lines: int = 25) -> None:
    print(f"\n{label} ({len(items)})")
    if not items:
        print("  -")
        return
    for item in items[:max_lines]:
        print(f"  {item}")
    if len(items) > max_lines:
        print(f"  ... +{len(items) - max_lines} more")


def preview_next(progress: Path, current: int, commits: list[tuple[str, str]]) -> None:
    nxt = current + 1
    if nxt > TOTAL:
        print(f"\nAll {TOTAL} snapshots are already published.")
        return
    previous = progress / f"{current:02d}" if current else None
    target = progress / f"{nxt:02d}"
    added, modified, deleted = compare_snapshots(previous, target)
    title, desc = commits[nxt - 1]
    print(f"\n=== Snapshot {nxt:02d}: {title} ===")
    print(desc)
    print_file_group("Added", added)
    print_file_group("Modified", modified)
    print_file_group("Deleted", deleted)
    print(f"\nTotal changed files: {len(added) + len(modified) + len(deleted)}")


def sensitive_paths(snapshot: Path) -> list[str]:
    hits = []
    for rel, path in relative_files(snapshot).items():
        name = path.name.lower()
        if name in SENSITIVE_EXACT or path.suffix.lower() in SENSITIVE_SUFFIXES:
            hits.append(rel)
    return sorted(hits)


def ensure_clean(repo: Path) -> None:
    lines = working_tree_lines(repo)
    if lines:
        shown = "\n".join(f"  {x}" for x in lines[:30])
        more = f"\n  ... +{len(lines) - 30} more" if len(lines) > 30 else ""
        raise PublisherError(
            "Publishing repo is not clean. Commit/stash/remove these changes first:\n"
            + shown + more
        )


def sync_snapshot(snapshot: Path, repo: Path) -> None:
    """Make tracked/public source state match snapshot without deleting ignored files."""
    source = public_relative_files(snapshot)
    target_paths = set(source)

    # Remove tracked files that do not belong in this snapshot.
    cp = git(["ls-files", "-z"], repo)
    tracked = [p for p in cp.stdout.split("\0") if p]
    for rel in tracked:
        if rel not in target_paths:
            p = repo / Path(rel)
            if p.exists() or p.is_symlink():
                if p.is_dir() and not p.is_symlink():
                    shutil.rmtree(p)
                else:
                    p.unlink()

    # Copy/overwrite the snapshot's complete public source snapshot.
    for rel, src in source.items():
        dst = repo / Path(rel)
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, dst)


def staged_summary(repo: Path) -> None:
    print("\n=== Staged change summary ===")
    cp = git(["diff", "--cached", "--stat"], repo, check=False)
    print(cp.stdout.strip() or "(no staged changes)")
    cp2 = git(["diff", "--cached", "--name-status"], repo, check=False)
    lines = cp2.stdout.splitlines()
    if lines:
        print("\nName/status:")
        for line in lines[:60]:
            print("  " + line)
        if len(lines) > 60:
            print(f"  ... +{len(lines)-60} more")


def branch_sync_guard(repo: Path, branch: str) -> None:
    if origin_url(repo) == "(no origin)":
        raise PublisherError("No 'origin' remote is configured.")
    if not has_remote_branch(repo, branch):
        return
    fetch_remote(repo, branch)
    # If HEAD has no commit yet, remote exists -> safest behavior is to block.
    head = git(["rev-parse", "--verify", "HEAD"], repo, check=False)
    if head.returncode != 0:
        raise PublisherError(
            f"Remote branch origin/{branch} already has commits while local repository has none.\n"
            "Clone the remote repository instead of using an empty local repo."
        )
    cp = git(["rev-list", "--left-right", "--count", f"HEAD...origin/{branch}"], repo)
    left, right = [int(x) for x in cp.stdout.split()]
    if right > 0:
        raise PublisherError(
            f"Local branch is behind origin/{branch} by {right} commit(s).\n"
            "Pull/reconcile the remote changes before publishing."
        )
    if left > 0:
        print(f"NOTE: local branch is ahead of origin/{branch} by {left} commit(s).")
        print("Those local commits will be pushed together with the snapshot.")


def push_head(repo: Path, branch: str) -> None:
    if has_remote_branch(repo, branch):
        git(["push", "origin", f"HEAD:{branch}"], repo)
    else:
        git(["push", "-u", "origin", f"HEAD:{branch}"], repo)


def update_state_after_push(state: dict, snapshot: int, title: str, repo: Path) -> None:
    commit_hash = git(["rev-parse", "HEAD"], repo).stdout.strip()
    entry = {
        "snapshot": snapshot,
        "title": title,
        "commit": commit_hash,
        "published_at": datetime.now().astimezone().isoformat(timespec="seconds"),
    }
    history = [x for x in state.get("history", []) if x.get("snapshot") != snapshot]
    history.append(entry)
    history.sort(key=lambda x: int(x.get("snapshot", 0)))
    state["published_snapshot"] = snapshot
    state["history"] = history
    save_json(STATE_FILE, state)


def retry_pending_push(repo: Path, branch: str, commits: list[tuple[str, str]], state: dict) -> bool:
    local = local_snapshot(repo, commits)
    remote = remote_snapshot(repo, branch, commits)
    if local <= remote:
        return False
    if local != remote + 1:
        raise PublisherError(
            f"Local snapshot is {local:02d} but remote is {remote:02d}; "
            "automatic recovery only supports one pending snapshot."
        )
    title = commits[local - 1][0]
    print(f"\nA local snapshot commit exists but is not on GitHub:")
    print(f"  {local:02d}. {title}")
    if not yes_no("Retry pushing this commit now?", default=True):
        return True
    branch_sync_guard(repo, branch)
    push_head(repo, branch)
    update_state_after_push(state, local, title, repo)
    print(f"\nSUCCESS: snapshot {local:02d} pushed.")
    return True


def publish_next(progress: Path, repo: Path, branch: str, commits: list[tuple[str, str]], state: dict) -> None:
    ensure_clean(repo)
    branch_sync_guard(repo, branch)

    remote = remote_snapshot(repo, branch, commits)
    local = local_snapshot(repo, commits)

    # If a prior commit was created but push failed, don't duplicate it.
    if local > remote:
        if retry_pending_push(repo, branch, commits, state):
            return

    current = remote

    # Preserve a clean snapshot history. Do not silently append snapshot 01
    # on top of an unrelated initialized repository.
    if current == 0 and local == 0:
        head = git(["rev-parse", "--verify", "HEAD"], repo, check=False)
        if head.returncode == 0:
            raise PublisherError(
                f"The target repository already has commit history that is not one of the {TOTAL} snapshots.\n"
                "For the intended clean progression, use a new/empty GitHub repository (no README/license initial commit)\n"
                "or a separate empty publishing repository. This script will not rewrite existing history."
            )

    nxt = current + 1
    if nxt > TOTAL:
        print(f"\nAll {TOTAL} snapshots are already published.")
        return

    snapshot = progress / f"{nxt:02d}"
    sensitive = sensitive_paths(snapshot)
    if sensitive:
        raise PublisherError(
            "Potentially sensitive files detected in snapshot; refusing to publish:\n  "
            + "\n  ".join(sensitive)
        )
    private_hits = private_public_paths(snapshot)
    if private_hits:
        raise PublisherError(
            "Private authoring/publishing files detected in snapshot; refusing to publish:\n  "
            + "\n  ".join(private_hits)
        )

    preview_next(progress, current, commits)
    title, desc = commits[nxt - 1]

    print("\nTarget:")
    print(f"  GitHub remote : {origin_url(repo)}")
    print(f"  Branch        : {branch}")
    print(f"  Snapshot     : {nxt:02d}/{TOTAL}")
    print(f"  Commit title  : {title}")

    confirmation = input(f"\nType PUBLISH {nxt:02d} to continue: ").strip()
    if confirmation != f"PUBLISH {nxt:02d}":
        print("Cancelled. Nothing changed.")
        return

    sync_snapshot(snapshot, repo)
    git(["add", "-A"], repo)

    staged = git(["diff", "--cached", "--quiet"], repo, check=False)
    if staged.returncode == 0:
        print("\nNo Git changes detected. Repository already matches this snapshot.")
        return

    # Basic patch sanity.
    check = git(["diff", "--cached", "--check"], repo, check=False)
    if check.returncode != 0:
        raise PublisherError(
            "git diff --cached --check failed; staged files were left intact for manual inspection:\n"
            + check.stdout
            + check.stderr
        )

    staged_summary(repo)
    final = input(f"\nType COMMIT {nxt:02d} to commit and push: ").strip()
    if final != f"COMMIT {nxt:02d}":
        print("\nCommit cancelled. Staged files are left intact for explicit manual inspection or cleanup.")
        return

    git(["commit", "-m", title], repo)
    commit_hash = git(["rev-parse", "--short", "HEAD"], repo).stdout.strip()
    print(f"\nCreated commit {commit_hash}: {title}")

    try:
        push_head(repo, branch)
    except PublisherError:
        print("\nThe commit was created locally, but push failed.")
        print("Run mct-publish again; it will detect the pending snapshot and offer to retry.")
        raise

    update_state_after_push(state, nxt, title, repo)
    print("\n" + "=" * 72)
    print(f"SUCCESS: snapshot {nxt:02d}/{TOTAL} is now on GitHub.")
    print(progress_bar(nxt))
    print(f"Commit: {commit_hash}  {title}")
    print("=" * 72)


def verify_repo(progress: Path, repo: Path, branch: str, commits: list[tuple[str, str]]) -> bool:
    remote = remote_snapshot(repo, branch, commits)
    local = local_snapshot(repo, commits)
    expected_n = remote if remote else local
    print("\n=== Verification ===")
    print(f"Local snapshot : {local:02d}")
    print(f"Remote snapshot: {remote:02d}")

    if expected_n == 0:
        print("No published snapshot detected yet.")
        return True

    snapshot = progress / f"{expected_n:02d}"
    expected = public_relative_files(snapshot)
    tracked_cp = git(["ls-files", "-z"], repo)
    tracked = {p for p in tracked_cp.stdout.split("\0") if p}

    missing = []
    mismatched = []
    extra_tracked = sorted(tracked - set(expected))

    for rel, src in expected.items():
        dst = repo / Path(rel)
        if not dst.is_file():
            missing.append(rel)
        elif sha256(src) != sha256(dst):
            mismatched.append(rel)

    ok = not missing and not mismatched and not extra_tracked and not working_tree_lines(repo)
    print(f"Expected snapshot: {expected_n:02d}")
    print(f"Missing        : {len(missing)}")
    print(f"Extra tracked  : {len(extra_tracked)}")
    print(f"Mismatched     : {len(mismatched)}")
    print(f"Working tree   : {'clean' if not working_tree_lines(repo) else 'DIRTY'}")

    for label, items in [("Missing", missing), ("Extra tracked", extra_tracked), ("Mismatched", mismatched)]:
        if items:
            print_file_group(label, items, max_lines=15)

    print("\nRESULT:", "PASS" if ok else "FAIL")
    return ok


def show_history(repo: Path, branch: str, commits: list[tuple[str, str]], state: dict) -> None:
    print("\n=== Publish history ===")
    history = state.get("history", [])
    if history:
        for item in history:
            n = int(item.get("snapshot", 0))
            commit = str(item.get("commit", ""))[:8]
            when = item.get("published_at", "?")
            title = item.get("title", "")
            print(f"{n:02d}  {commit:8}  {when}  {title}")
    else:
        print("(No local publisher history yet.)")

    if has_remote_branch(repo, branch):
        fetch_remote(repo, branch)
        print(f"\nRecent GitHub branch commits (origin/{branch}):")
        cp = git(["log", f"origin/{branch}", "--max-count=25", "--pretty=format:%h  %ad  %s", "--date=short"], repo)
        print(cp.stdout or "(none)")


def show_roadmap(commits: list[tuple[str, str]], current: int) -> None:
    print(f"\n=== {TOTAL}-snapshot roadmap ===")
    for i, (title, desc) in enumerate(commits, start=1):
        marker = "[x]" if i <= current else "[>]" if i == current + 1 else "[ ]"
        print(f"{marker} {i:02d}. {title}")
        print(f"       {desc}")


def status_screen(progress: Path, repo: Path, branch: str, commits: list[tuple[str, str]], state: dict) -> tuple[int, int]:
    try:
        remote = remote_snapshot(repo, branch, commits)
    except PublisherError as exc:
        print(f"\nRemote check warning: {exc}")
        remote = int(state.get("published_snapshot", 0) or 0)
    local = local_snapshot(repo, commits)
    dirty = working_tree_lines(repo)

    print("\n" + "=" * 78)
    print(f"{APP_NAME:^78}")
    print("=" * 78)
    print(f"Progress : {progress_bar(remote)}")
    print(f"Remote   : {origin_url(repo)}")
    print(f"Branch   : {branch}")
    print(f"Repo     : {repo}")
    print(f"Snapshots: {progress}")
    print(f"Local    : snapshot {local:02d}")
    print(f"GitHub   : snapshot {remote:02d}")
    print(f"Tree     : {'DIRTY (' + str(len(dirty)) + ' change(s))' if dirty else 'clean'}")
    print(f"Last     : {repo_last_commit(repo)}")
    if remote < TOTAL:
        title, desc = commits[remote]
        print("-" * 78)
        print(f"NEXT     : {remote + 1:02d}. {title}")
        print(f"           {desc}")
    else:
        print("-" * 78)
        print(f"COMPLETE : All {TOTAL} snapshots are published.")
    print("=" * 78)
    return local, remote


def menu(cfg: dict) -> None:
    progress = Path(cfg["progress_dir"])
    repo = Path(cfg["repo_dir"])
    branch = cfg["branch"]
    validate_progress(progress)
    commits = load_commits(progress)
    state = load_json(STATE_FILE, {"published_snapshot": 0, "history": []})

    while True:
        _, remote = status_screen(progress, repo, branch, commits, state)
        print("\n1) Preview next snapshot")
        print("2) Publish/update next snapshot")
        print("3) View publish history")
        print("4) Verify repo against published snapshot")
        print(f"5) Show all {TOTAL} snapshots")
        print("6) Reconfigure paths/branch")
        print("0) Exit")
        choice = input("\nChoose: ").strip()

        try:
            if choice == "1":
                preview_next(progress, remote, commits)
            elif choice == "2":
                if remote >= 11:
                    # This is a disposable publishing clone.
                    # origin/<base> is always the source of truth.
                    if detect_branch(repo) != branch:
                        git(["reset", "--hard", "HEAD"], repo)
                        git(["switch", branch], repo)

                    fetch_remote(repo, branch)
                    git(["reset", "--hard", f"origin/{branch}"], repo)

                    remote = remote_snapshot(repo, branch, commits)
                    requested = remote + 1
                    feature = BRANCH_NAMES.get(requested)

                    if not feature:
                        raise PublisherError(
                            f"No feature branch is configured for snapshot {requested:02d}."
                        )

                    local_feature = (
                        git(
                            ["show-ref", "--verify", f"refs/heads/{feature}"],
                            repo,
                            check=False,
                        ).returncode
                        == 0
                    )
                    remote_feature = has_remote_branch(repo, feature)

                    if remote_feature:
                        print(
                            f"\nSnapshot {requested:02d} is already pushed on {feature}."
                        )

                        if _gh_ready(repo):
                            existing = run(
                                [
                                    "gh",
                                    "pr",
                                    "list",
                                    "--head",
                                    feature,
                                    "--state",
                                    "open",
                                    "--json",
                                    "url",
                                    "--jq",
                                    ".[0].url",
                                ],
                                cwd=repo,
                                check=False,
                            )

                            pr_url = existing.stdout.strip()

                            if pr_url:
                                print(f"Pull request: {pr_url}")
                            else:
                                title, description = commits[requested - 1]
                                body = (
                                    f"{description}\n\n"
                                    "CI must pass before merge."
                                )

                                created = run(
                                    [
                                        "gh",
                                        "pr",
                                        "create",
                                        "--base",
                                        branch,
                                        "--head",
                                        feature,
                                        "--title",
                                        title,
                                        "--body",
                                        body,
                                    ],
                                    cwd=repo,
                                    check=False,
                                )

                                if created.returncode == 0:
                                    pr_url = created.stdout.strip()
                                    print(f"Pull request: {pr_url}")
                                else:
                                    print(
                                        "Feature branch is already on GitHub, "
                                        "but the PR could not be opened automatically."
                                    )

                        print(
                            "Nothing was republished. Merge the existing PR "
                            "after CI passes."
                        )

                    else:
                        # Local-only feature branches are abandoned publisher
                        # attempts. The snapshot directory remains authoritative,
                        # so recreating the branch is safe.
                        if local_feature:
                            git(["branch", "-D", feature], repo)

                        publish_pull_request(
                            progress,
                            repo,
                            branch,
                            commits,
                            state,
                            requested,
                            assume_yes=False,
                        )
                else:
                    publish_next(progress, repo, branch, commits, state)

                state = load_json(
                    STATE_FILE,
                    {"published_snapshot": 0, "history": []},
                )
            elif choice == "3":
                show_history(repo, branch, commits, state)
            elif choice == "4":
                verify_repo(progress, repo, branch, commits)
            elif choice == "5":
                show_roadmap(commits, remote)
            elif choice == "6":
                cfg = setup_config(force=True)
                progress = Path(cfg["progress_dir"])
                repo = Path(cfg["repo_dir"])
                branch = cfg["branch"]
                validate_progress(progress)
                commits = load_commits(progress)
            elif choice == "0":
                return
            else:
                print("Unknown choice.")
        except PublisherError as exc:
            print(f"\nERROR: {exc}")

        input("\nPress Enter to return to menu...")


def preview_snapshot(progress: Path, snapshot: int, commits: list[tuple[str, str]]) -> None:
    if snapshot < 1 or snapshot > TOTAL:
        raise PublisherError(f"Snapshot must be between 1 and {TOTAL}.")
    target = progress / f"{snapshot:02d}"
    if not target.is_dir():
        raise PublisherError(f"Requested snapshot does not exist: {target}")
    previous = progress / f"{snapshot - 1:02d}" if snapshot > 1 else None
    added, modified, deleted = compare_snapshots(previous, target)
    title, desc = commits[snapshot - 1]
    print(f"\n=== Snapshot {snapshot:02d}: {title} ===")
    print(desc)
    print_file_group("Added", added)
    print_file_group("Modified", modified)
    print_file_group("Deleted", deleted)
    print(f"\nTotal changed files: {len(added) + len(modified) + len(deleted)}")


def _module_available(name: str) -> bool:
    return importlib.util.find_spec(name) is not None


def validate_snapshot(snapshot: Path) -> None:
    if not snapshot.is_dir():
        raise PublisherError(f"Requested snapshot does not exist: {snapshot}")
    sensitive = sensitive_paths(snapshot)
    private_hits = private_public_paths(snapshot)
    if sensitive or private_hits:
        lines = [*(f"sensitive: {item}" for item in sensitive), *(f"private: {item}" for item in private_hits)]
        raise PublisherError("Snapshot contains files that cannot be published:\n  " + "\n  ".join(lines))
    whitespace_errors: list[str] = []
    text_suffixes = {".py", ".md", ".sql", ".yml", ".yaml", ".json", ".toml", ".txt", ".sh", ".ps1", ".cmd"}
    for rel, path in public_relative_files(snapshot).items():
        if path.suffix.lower() not in text_suffixes and path.name not in {"Dockerfile", "Makefile"}:
            continue
        try:
            lines = path.read_text(encoding="utf-8").splitlines()
        except UnicodeDecodeError as exc:
            raise PublisherError(f"Public text file is not UTF-8: {rel}") from exc
        for number, line in enumerate(lines, 1):
            if line.rstrip(" \t") != line:
                whitespace_errors.append(f"{rel}:{number}: trailing whitespace")
            if "<<<<<<< " in line or line.startswith("=======") or line.startswith(">>>>>>> "):
                whitespace_errors.append(f"{rel}:{number}: merge conflict marker")
    if whitespace_errors:
        raise PublisherError("Snapshot whitespace/conflict validation failed:\n  " + "\n  ".join(whitespace_errors[:30]))


def _require_validator(module: str, label: str) -> None:
    if not _module_available(module):
        raise PublisherError(f"Required validator is unavailable for noninteractive publishing: {label}")


def validate_staged_project(repo: Path, snapshot: int, *, conservative: bool) -> None:
    check = git(["diff", "--cached", "--check"], repo, check=False)
    if check.returncode != 0:
        raise PublisherError("git diff --cached --check failed:\n" + check.stdout + check.stderr)

    compile_targets = [name for name in ("src", "tests", "scripts", "airflow/dags") if (repo / name).exists()]
    if compile_targets:
        run([sys.executable, "-m", "compileall", "-q", *compile_targets], cwd=repo)

    validators = [
        ("ruff", [sys.executable, "-m", "ruff", "check", "."], "Ruff"),
        ("black", [sys.executable, "-m", "black", "--check", "."], "Black"),
        ("isort", [sys.executable, "-m", "isort", "--check-only", "."], "isort"),
        ("mypy", [sys.executable, "-m", "mypy", "src"], "MyPy"),
        ("pytest", [sys.executable, "-m", "pytest", "-q"], "pytest"),
    ]
    for module, command, label in validators:
        if _module_available(module):
            print(f"Running {label}...")
            run(command, cwd=repo)
        elif conservative:
            _require_validator(module, label)

    if (repo / "dbt").is_dir():
        dbt_executable = shutil.which("dbt")
        if dbt_executable:
            run([dbt_executable, "deps", "--project-dir", "dbt", "--profiles-dir", "dbt"], cwd=repo)
            run([dbt_executable, "parse", "--project-dir", "dbt", "--profiles-dir", "dbt", "--no-partial-parse"], cwd=repo)
        elif conservative:
            raise PublisherError("Required validator is unavailable for noninteractive publishing: dbt")

    if snapshot >= 27:
        docker = shutil.which("docker")
        if docker:
            run([docker, "compose", "--profile", "demo", "config"], cwd=repo)
            run([docker, "build", "-t", f"mobility-control-tower:snapshot-{snapshot:02d}", "."], cwd=repo)
        elif conservative:
            raise PublisherError("Docker is required for noninteractive publication of runtime snapshots.")


def _sync_private_state(state: dict, remote: int, local: int) -> None:
    recorded = int(state.get("published_snapshot", 0) or 0)
    if remote == local and remote > recorded:
        state["published_snapshot"] = remote
        state.pop("pending_pr", None)
        save_json(STATE_FILE, state)


def _verify_next_snapshot(
    progress: Path,
    repo: Path,
    base_branch: str,
    commits: list[tuple[str, str]],
    state: dict,
    requested: int,
) -> int:
    validate_progress(progress)
    validate_snapshot(progress / f"{requested:02d}")
    ensure_clean(repo)
    if detect_branch(repo) != base_branch:
        raise PublisherError(f"Publishing clone must be on {base_branch!r}, not {detect_branch(repo)!r}.")
    if origin_url(repo) == "(no origin)" or not has_remote_branch(repo, base_branch):
        raise PublisherError(f"Remote base branch origin/{base_branch} is unavailable.")
    fetch_remote(repo, base_branch)
    head = git(["rev-parse", "HEAD"], repo).stdout.strip()
    remote_head = git(["rev-parse", f"origin/{base_branch}"], repo).stdout.strip()
    if head != remote_head:
        raise PublisherError(f"Local {base_branch} must exactly match origin/{base_branch} before publishing.")
    remote = remote_snapshot(repo, base_branch, commits)
    local = local_snapshot(repo, commits)
    _sync_private_state(state, remote, local)
    recorded = int(state.get("published_snapshot", 0) or 0)
    if local != remote or recorded != remote:
        raise PublisherError(f"Snapshot state mismatch: local={local:02d}, remote={remote:02d}, publisher={recorded:02d}.")
    if requested != remote + 1:
        raise PublisherError(f"Snapshot {requested:02d} is not next; origin/{base_branch} is at {remote:02d}.")
    return remote


def _gh_ready(repo: Path) -> bool:
    if shutil.which("gh") is None:
        return False
    return run(["gh", "auth", "status"], cwd=repo, check=False).returncode == 0


def publish_pull_request(
    progress: Path,
    repo: Path,
    base_branch: str,
    commits: list[tuple[str, str]],
    state: dict,
    requested: int,
    *,
    assume_yes: bool,
) -> None:
    _verify_next_snapshot(progress, repo, base_branch, commits, state, requested)
    branch = BRANCH_NAMES.get(requested)
    if not branch:
        raise PublisherError(f"No feature branch is configured for snapshot {requested:02d}.")
    if git(["show-ref", "--verify", f"refs/heads/{branch}"], repo, check=False).returncode == 0 or has_remote_branch(repo, branch):
        raise PublisherError(f"Feature branch already exists; inspect it manually before retrying: {branch}")

    preview_snapshot(progress, requested, commits)
    title, description = commits[requested - 1]
    if not assume_yes:
        confirmation = input(f"\nType PUBLISH {requested:02d} to create and push {branch}: ").strip()
        if confirmation != f"PUBLISH {requested:02d}":
            print("Cancelled. Nothing changed.")
            return

    git(["switch", "-c", branch], repo)
    sync_snapshot(progress / f"{requested:02d}", repo)
    git(["add", "-A"], repo)
    staged = git(["diff", "--cached", "--quiet"], repo, check=False)
    if staged.returncode == 0:
        raise PublisherError("Snapshot produced no Git changes; refusing to create an empty snapshot.")
    github_ci_only = os.environ.get("MCT_GITHUB_CI_ONLY", "1") == "1"
    if github_ci_only:
        check = git(["diff", "--cached", "--check"], repo, check=False)
        if check.returncode != 0:
            raise PublisherError(
                "git diff --cached --check failed:\n" + check.stdout + check.stderr
            )
        print("Local full validation skipped; GitHub CI is the merge gate.")
    else:
        validate_staged_project(repo, requested, conservative=assume_yes)
    staged_summary(repo)
    if not assume_yes:
        confirmation = input(f"\nType COMMIT {requested:02d} to commit and push the feature branch: ").strip()
        if confirmation != f"COMMIT {requested:02d}":
            raise PublisherError("Commit cancelled; the feature branch is left intact for inspection.")

    git(["commit", "-m", title], repo)
    git(["push", "-u", "origin", branch], repo)
    pr_url = None
    if _gh_ready(repo):
        if github_ci_only:
            body = f"{description}\n\nCI must pass before merge."
        else:
            body = f"{description}\n\nValidation was run locally before this branch was pushed. CI must pass before merge."
        created = run(["gh", "pr", "create", "--base", base_branch, "--head", branch, "--title", title, "--body", body], cwd=repo)
        pr_url = created.stdout.strip().splitlines()[-1] if created.stdout.strip() else None
    state["pending_pr"] = {
        "snapshot": requested,
        "branch": branch,
        "commit": git(["rev-parse", "HEAD"], repo).stdout.strip(),
        "pr_url": pr_url,
        "created_at": datetime.now().astimezone().isoformat(timespec="seconds"),
    }
    save_json(STATE_FILE, state)
    print(f"\nFeature branch pushed: {branch}")
    print(f"Pull request: {pr_url or 'not opened; GitHub CLI is unavailable or not authenticated'}")
    print("The base branch and published snapshot are unchanged until the PR is reviewed and merged.")


def create_release(repo: Path, branch: str, commits: list[tuple[str, str]], snapshot: int, *, assume_yes: bool) -> None:
    tag = RELEASES.get(snapshot)
    if not tag:
        raise PublisherError(f"Snapshot {snapshot:02d} is not a configured release boundary.")
    ensure_clean(repo)
    if detect_branch(repo) != branch:
        raise PublisherError(f"Release clone must be on {branch!r}.")
    fetch_remote(repo, branch)
    local = local_snapshot(repo, commits)
    remote = remote_snapshot(repo, branch, commits)
    if local != snapshot or remote != snapshot:
        raise PublisherError(f"Release {tag} requires local and remote snapshot {snapshot:02d}; found local={local:02d}, remote={remote:02d}.")
    if git(["rev-parse", "HEAD"], repo).stdout.strip() != git(["rev-parse", f"origin/{branch}"], repo).stdout.strip():
        raise PublisherError(f"Local {branch} does not exactly match origin/{branch}.")
    if git(["show-ref", "--verify", f"refs/tags/{tag}"], repo, check=False).returncode == 0:
        raise PublisherError(f"Local tag already exists: {tag}")
    if git(["ls-remote", "--exit-code", "--tags", "origin", f"refs/tags/{tag}"], repo, check=False).returncode == 0:
        raise PublisherError(f"Remote tag already exists: {tag}")
    if not assume_yes and input(f"Type RELEASE {tag} to create the real tag now: ").strip() != f"RELEASE {tag}":
        print("Cancelled. Nothing changed.")
        return
    git(["tag", "-a", tag, "-m", f"{tag} - {commits[snapshot - 1][0]}"], repo)
    git(["push", "origin", tag], repo)
    if _gh_ready(repo):
        run(["gh", "release", "create", tag, "--verify-tag", "--generate-notes", "--title", tag], cwd=repo)
    print(f"Created {tag} with the actual current tag timestamp; no commit dates were changed.")


def main() -> int:
    parser = argparse.ArgumentParser(description=APP_NAME)
    parser.add_argument(
        "command",
        nargs="?",
        choices=["menu", "status", "preview", "publish", "history", "verify", "roadmap", "setup"],
        default="menu",
    )
    parser.add_argument("--preview", type=int, metavar="NN", help="preview a specific snapshot")
    parser.add_argument("--publish", type=int, metavar="NN", help="validate and publish the next snapshot through a feature-branch PR")
    parser.add_argument("--release", type=int, metavar="NN", help="create the configured release tag after its snapshot is merged")
    parser.add_argument("--yes", action="store_true", help="noninteractive fail-closed mode for scheduled execution")
    parser.add_argument("--pr", action="store_true", help="explicitly select PR mode (the required mode for snapshots 12+)")
    args = parser.parse_args()

    try:
        # Verify git before setup.
        run(["git", "--version"])
        cfg = setup_config(force=(args.command == "setup"))
        progress = Path(cfg["progress_dir"])
        repo = Path(cfg["repo_dir"])
        branch = cfg["branch"]
        validate_progress(progress)
        commits = load_commits(progress)
        state = load_json(STATE_FILE, {"published_snapshot": 0, "history": []})

        selected_actions = sum(value is not None for value in (args.preview, args.publish, args.release))
        if selected_actions > 1:
            raise PublisherError("Choose only one of --preview, --publish, or --release.")
        if args.yes and args.publish is None and args.release is None:
            raise PublisherError("--yes is valid only with --publish or --release.")
        if args.pr and args.publish is None:
            raise PublisherError("--pr is valid only with --publish.")

        if args.preview is not None:
            preview_snapshot(progress, args.preview, commits)
        elif args.publish is not None:
            if args.publish < 12:
                raise PublisherError("The PR publisher does not rewrite or republish public snapshots 01-11.")
            publish_pull_request(progress, repo, branch, commits, state, args.publish, assume_yes=args.yes)
        elif args.release is not None:
            create_release(repo, branch, commits, args.release, assume_yes=args.yes)
        elif args.command in {"menu", "setup"}:
            menu(cfg)
        elif args.command == "status":
            remote = remote_snapshot(repo, branch, commits)
            local = local_snapshot(repo, commits)
            _sync_private_state(state, remote, local)
            status_screen(progress, repo, branch, commits, state)
        elif args.command == "preview":
            remote = remote_snapshot(repo, branch, commits)
            preview_next(progress, remote, commits)
        elif args.command == "publish":
            remote = remote_snapshot(repo, branch, commits)
            if remote >= 11:
                publish_pull_request(progress, repo, branch, commits, state, remote + 1, assume_yes=False)
            else:
                publish_next(progress, repo, branch, commits, state)
        elif args.command == "history":
            show_history(repo, branch, commits, state)
        elif args.command == "verify":
            ok = verify_repo(progress, repo, branch, commits)
            return 0 if ok else 2
        elif args.command == "roadmap":
            remote = remote_snapshot(repo, branch, commits)
            show_roadmap(commits, remote)
        return 0
    except PublisherError as exc:
        print(f"\nERROR: {exc}")
        return 1
    except KeyboardInterrupt:
        print("\nCancelled.")
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
