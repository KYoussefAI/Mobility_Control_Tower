#!/usr/bin/env python3
"""
Mobility Control Tower progressive GitHub publisher.

Default behavior:
    mct-publish
opens an interactive menu that previews and publishes exactly one snapshot
at a time from progress/01 ... progress/33 into a separate Git working copy.

The publisher NEVER changes the progress snapshots themselves. It also does
not store GitHub tokens; authentication is delegated to Git / GitHub CLI.
"""

from __future__ import annotations

import argparse
import hashlib
import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path
from typing import Iterable

APP_NAME = "MCT Progressive Publisher"
TOTAL = 33
SCRIPT_DIR = Path(__file__).resolve().parent
APP_DIR = SCRIPT_DIR / ".mct-publisher"
CONFIG_FILE = APP_DIR / "config.json"
STATE_FILE = APP_DIR / "state.json"

